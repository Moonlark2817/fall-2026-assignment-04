erDiagram
    USERS ||--o| BORROWERS : has
    GENRES ||--o{ BOOKS : contains
    BOOKS ||--o{ BOOK_AUTHORS : has
    AUTHORS ||--o{ BOOK_AUTHORS : writes
    BORROWERS ||--o{ LOANS : borrows
    BOOKS ||--o{ LOANS : includes

    USERS {
        int id PK
        string email
        string name
        timestamp created_at
    }

    BORROWERS {
        int id PK
        int user_id FK
        string membership_status
    }

    GENRES {
        int id PK
        string name
        string description
    }

    BOOKS {
        int id PK
        int genre_id FK
        string title
        string isbn
        int published_year
    }

    AUTHORS {
        int id PK
        string name
        string bio
    }

    BOOK_AUTHORS {
        int id PK
        int book_id FK
        int author_id FK
    }

    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        date checkout_date
        date due_date
        date return_date
    }
